---
import type { BlogPost } from '../lib/posts';
import { formatDate, getPostDisplayDate, isoDate } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <div class="writing-empty">
    <p class="writing-empty-mark" aria-hidden="true">✎</p>
    <h3 class="writing-empty-title">The first page is still blank.</h3>
    <p class="writing-empty-copy">
      No writing yet. When something is worth putting into words, it will
      appear here.
    </p>
  </div>
) : (
  <div class="writing-list">
    {posts.map((post) => {
      const href = `/blog/${post.id}/`;
      const displayDate = getPostDisplayDate(post);
      return (
        <article class="writing-entry">
          <div class="writing-entry-date">
            {displayDate && (
              <time datetime={isoDate(displayDate)}>
                {formatDate(displayDate, 'long')}
              </time>
            )}
            {post.data.draft && <span class="badge badge--draft">Draft</span>}
          </div>
          <div class="writing-entry-main">
            <h3 class="writing-entry-title">
              <a href={href}>{post.data.title}</a>
            </h3>
            <p class="writing-entry-desc">{post.data.description}</p>
          </div>
          <span class="writing-entry-arrow" aria-hidden="true">
            <Icon name="arrow-up-right" size={17} />
          </span>
        </article>
      );
    })}
  </div>
)}
