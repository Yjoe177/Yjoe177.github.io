---
import { BLOG_CATEGORIES, categorySlug } from '../lib/categories';
import type { BlogPost } from '../lib/posts';
import { formatDate, groupByYear, readingTime } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  posts: BlogPost[];
  activeCategory?: string;
}

const { posts, activeCategory } = Astro.props;
const groups = groupByYear(posts);
const activeCategoryName = BLOG_CATEGORIES.find((category) => category.slug === activeCategory)?.name;
---

<nav class="filter-list" aria-label="Filter journal by category">
  <a
    class="filter-link"
    href="/blog/"
    aria-current={!activeCategory ? 'page' : undefined}
  >
    All entries
  </a>
  {BLOG_CATEGORIES.map((category) => (
    <a
      class="filter-link"
      href={`/blog/category/${category.slug}/`}
      aria-current={activeCategory === category.slug ? 'page' : undefined}
    >
      {category.name}
    </a>
  ))}
</nav>

<div class="journal-index">
  {posts.length === 0 ? (
    activeCategory ? (
      <div class="empty-state">
        <p class="empty-state-title">Nothing filed under {activeCategoryName} yet.</p>
        <p>
          New writing will appear here when it is ready. In the meantime,
          browse <a class="text-link" href="/blog/">all journal entries</a>.
        </p>
      </div>
    ) : (
      <div class="journal-empty">
        <div class="journal-empty-main">
          <p class="journal-empty-mark" aria-hidden="true">“</p>
          <p class="eyebrow">The journal</p>
          <h2 class="journal-empty-title">The first entries are still being written.</h2>
          <p class="journal-empty-copy">
            This is where longer thoughts will live — essays, stories, research
            notes, and pieces of life that do not fit into a paper. The shelf is
            ready; the first pages are on their way.
          </p>
          <div class="journal-empty-actions">
            <a class="button" href="/research/">
              Explore the research
              <Icon name="arrow-right" size={14} />
            </a>
            <a class="button button--ghost" href="/about/">About me</a>
          </div>
        </div>

        <div class="journal-empty-aside">
          <h3 class="journal-empty-aside-title">What will be here</h3>
          <ul class="journal-empty-categories">
            {BLOG_CATEGORIES.map((category) => (
              <li>
                <a href={`/blog/category/${category.slug}/`}>
                  <span class="journal-empty-category-name">{category.name}</span>
                  <span class="journal-empty-category-desc">{category.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  ) : (
    groups.map((group) => (
      <section class="year-group" aria-labelledby={`year-${group.year}`}>
        <h2 class="year-heading" id={`year-${group.year}`}>{group.year}</h2>
        {group.posts.map((post) => {
          const href = `/blog/${post.id}/`;
          const minutes = readingTime(post.body);
          return (
            <article class="journal-entry">
              <time class="journal-entry-date" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate, 'short')}
              </time>
              <div class="journal-entry-main">
                <h3 class="journal-entry-title">
                  <a href={href}>{post.data.title}</a>
                </h3>
                <p class="journal-entry-desc">{post.data.description}</p>
              </div>
              <div class="journal-entry-meta">
                <a
                  class="journal-entry-category"
                  href={`/blog/category/${categorySlug(post.data.category)}/`}
                >
                  {post.data.category}
                </a>
                <span>{minutes} min read</span>
                {post.data.draft && (
                  <div class="journal-entry-badges">
                    <span class="badge badge--draft">Draft</span>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </section>
    ))
  )}
</div>
