---
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'download'
  | 'mail'
  | 'rss'
  | 'sun'
  | 'moon';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6"></path>}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9"></path>}
  {name === 'download' && <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"></path>}
  {name === 'mail' && (
    <g>
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m3 7 9 6 9-6"></path>
    </g>
  )}
  {name === 'rss' && (
    <g>
      <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
      <circle cx="5" cy="19" r="1"></circle>
    </g>
  )}
  {name === 'sun' && (
    <g>
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </g>
  )}
  {name === 'moon' && <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>}
</svg>
