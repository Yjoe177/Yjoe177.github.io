---
import type { BlogPost } from '../lib/posts';
import { formatDate, getPostDisplayDate, isoDate } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const href = `/blog/${post.id}/`;
const displayDate = getPostDisplayDate(post);
---

<article class="post-preview">
  <div class="post-preview-main">
    <h3 class="post-preview-title">
      <a href={href}>{post.data.title}</a>
    </h3>
    {(displayDate || post.data.draft) && (
      <div class="post-preview-meta">
        {displayDate && (
          <span class="post-preview-date">
            <time datetime={isoDate(displayDate)}>{formatDate(displayDate, 'long')}</time>
          </span>
        )}
        {post.data.draft && <span class="badge badge--draft">Draft</span>}
      </div>
    )}
  </div>
  <span class="post-preview-arrow" aria-hidden="true">
    <Icon name="arrow-up-right" size={16} />
  </span>
</article>
