---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsList from '../components/NewsList.astro';
import PostPreview from '../components/PostPreview.astro';
import Portrait from '../components/Portrait.astro';
import Icon from '../components/Icon.astro';
import { siteConfig, activeContactLinks, hasEmail } from '../config/site';
import { news } from '../data/news';
import { getResearch } from '../lib/research';
import { getPosts } from '../lib/posts';

const projects = await getResearch({ includeDrafts: import.meta.env.DEV });
const featured = (projects.filter((project) => project.data.featured).length > 0
  ? projects.filter((project) => project.data.featured)
  : projects
).slice(0, 2);

const posts = (await getPosts({ includeDrafts: import.meta.env.DEV })).slice(0, 3);
const recentNews = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: siteConfig.role,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: siteConfig.affiliation,
  },
  description: siteConfig.description,
  url: canonical,
  knowsAbout: siteConfig.researchInterests,
  sameAs: activeContactLinks.map((link) => link.href),
};
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
  structuredData={structuredData}
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{siteConfig.role} · {siteConfig.affiliation}</p>
      <h1 class="hero-title" id="hero-title">{siteConfig.name}</h1>
      <p class="hero-lede">{siteConfig.tagline}</p>
      <p class="hero-body">{siteConfig.bio.short}</p>

      <ul class="chip-list hero-chips" aria-label="Research interests">
        {siteConfig.researchInterests.map((interest) => (
          <li class="chip">{interest}</li>
        ))}
      </ul>

      <div class="hero-actions">
        <a class="button" href="/research/">
          Explore research
          <Icon name="arrow-right" size={15} />
        </a>
        <a class="button button--ghost" href="/blog/">Read the journal</a>
      </div>

      <p class="hero-current">
        <strong>Currently</strong>
        <span>Exploring TinyML and agentic kernel optimization</span>
        <span class="dot" aria-hidden="true"></span>
        <span>{siteConfig.location}</span>
      </p>
    </div>

    <div class="hero-aside">
      <Portrait loading="eager" />
      <dl class="hero-facts">
        <div>
          <dt>Based in</dt>
          <dd>{siteConfig.location}</dd>
        </div>
        <div>
          <dt>Field</dt>
          <dd>Artificial intelligence</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Efficient &amp; edge AI</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>Undergraduate</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading
        index="01"
        title="Selected research"
        href="/research/"
        linkLabel="All research"
      />
      {featured.length > 0 ? (
        <div class="project-grid">
          {featured.map((project, index) => (
            <ProjectCard project={project} position={index + 1} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p class="empty-state-title">Research pages are being prepared.</p>
          <p>Project write-ups will appear here soon.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container split-section">
      <div>
        <SectionHeading index="02" title="Recent news" />
        <NewsList items={recentNews} limit={3} />
      </div>
      <div>
        <SectionHeading
          index="03"
          title="From the journal"
          href="/blog/"
          linkLabel="All entries"
        />
        {posts.length > 0 ? (
          <div class="post-preview-list">
            {posts.map((post) => <PostPreview post={post} />)}
          </div>
        ) : (
          <div class="empty-state">
            <p class="empty-state-title">Words are on the way.</p>
            <p>
              Journal entries will appear here as they are written.
              <a class="text-link" href="/blog/">Visit the journal</a>
              to see what is planned.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-panel">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="contact-panel-title">Let’s compare notes.</h2>
          <p class="contact-panel-copy">
            For research conversations, collaboration, or questions about my work,
            the contact page has the details.
          </p>
        </div>
        <div class="contact-panel-links">
          {hasEmail && (
            <a href={`mailto:${siteConfig.email}`}>
              <Icon name="mail" size={14} />
              {siteConfig.email}
            </a>
          )}
          {activeContactLinks.slice(0, 3).map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <Icon name="arrow-up-right" size={13} />
            </a>
          ))}
          <a href="/contact/">
            Contact page
            <Icon name="arrow-right" size={13} />
          </a>
          <a href="/cv/">
            Curriculum vitae
            <Icon name="download" size={13} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
